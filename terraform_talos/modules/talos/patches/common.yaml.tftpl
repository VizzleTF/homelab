machine:
  features:
    rbac: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
---
apiVersion: v1alpha1
kind: KubeletConfig
extraArgs:
  rotate-server-certificates: "true"
config:
  serverTLSBootstrap: true
  # Eviction kills app pods before cilium/longhorn/etcd/kubelet starve (OOM
  # cascades). evictionMinimumReclaim stops MemoryPressure flapping.
  systemReserved:
    cpu: 200m
    memory: 512Mi
  kubeReserved:
    cpu: 200m
    memory: 512Mi
  evictionHard:
    memory.available: 200Mi
    nodefs.available: 10%
  evictionMinimumReclaim:
    memory.available: 300Mi
    nodefs.available: 5%
---
# Longhorn data dir: a user volume reaches the kubelet without extraMount
# (none in v1.14 documents, siderolabs/talos#14365). Directory on EPHEMERAL.
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
volumeType: directory
---
apiVersion: v1alpha1
kind: ResolverConfig
# OpenWrt resolves split-horizon names (git.example.com) for image pulls; the
# Talos fallback 1.1.1.1/8.8.8.8 returns NXDOMAIN for them.
nameservers:
  - address: ${gateway}
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
%{ for e in host_entries ~}
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: ${e.ip}
hostnames:
  - ${e.hostname}
%{ endfor ~}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: ${install_image}
---
# Spegel serves layers to peers from the content store. containerd 2.x key:
# io.containerd.cri.v1.images, not io.containerd.grpc.v1.cri.
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: spegel
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
---
# Hugepages serve only the Longhorn v2 engine (off). "0", not removal: Talos
# keeps a removed sysctl live until reboot. Restore with v2.
apiVersion: v1alpha1
kind: SysctlConfig
params:
  vm.nr_hugepages: "0"
---
# Sandbox PID+mount namespace for CRI/kubelet/pods; takes effect on reboot.
# Verified 2026-10-17: Longhorn iSCSI, Cilium, Spegel, Intel GPU plugin.
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: true
