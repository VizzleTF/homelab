machine:
  certSANs:
%{ for ip in cp_node_ips ~}
    - ${ip}
%{ endfor ~}
  nodeLabels:
    node.kubernetes.io/exclude-from-external-load-balancers: ""
  features:
    # Required by tuppr (home-operations/tuppr) — controller runs inside the
    # cluster and uses the Talos API to drive node upgrades. Without this
    # feature the controller cannot reach the Talos API and TalosUpgrade CRs
    # fail with auth errors. Scope limited to ns system-upgrade + os:admin role.
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:admin
      allowedKubernetesNamespaces:
        - system-upgrade
cluster:
  apiServer:
    certSANs:
%{ for s in apiserver_cert_sans ~}
      - ${s}
%{ endfor ~}
%{ for ip in cp_node_ips ~}
      - ${ip}
%{ endfor ~}
    admissionControl:
      - name: PodSecurity
        configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1alpha1
          defaults:
            audit: restricted
            audit-version: latest
            enforce: privileged
            enforce-version: latest
            warn: restricted
            warn-version: latest
          # exemptions omitted — Talos already defaults to namespaces:[kube-system];
          # listing it here causes strategic-merge list-append → duplicate entry →
          # kube-apiserver fails with "exemptions.namespaces[1]: Duplicate value".
          kind: PodSecurityConfiguration
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
  etcd:
    # Dedicated unauthenticated metrics/health listener so VictoriaMetrics can
    # scrape etcd (kubeEtcd). Plain HTTP on 2381 — reachable only on the
    # servers VLAN behind the host firewall.
    #
    # Compaction: kube-apiserver already compacts etcd every 5 min
    # (--etcd-compaction-interval default), so etcd's own periodic compaction
    # was a duplicate and is gone (2026-10). Quota raised to 8 GiB headroom.
    # Talos does NOT auto-defrag; defrag stays manual: `talosctl etcd defrag`
    # (leader last, only when dbSize vs dbSizeInUse diverge >40%).
    #
    # heartbeat 250 ms / election 2.5 s instead of 100 ms / 1 s: fsync on the
    # shared DRAM-less SATA SSDs spikes past 1 s, and every false election adds
    # churn. Must be identical on all members.
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
      quota-backend-bytes: "8589934592"
      heartbeat-interval: "250"
      election-timeout: "2500"
  # Leader-election renewals are writes to etcd (a lease PUT every retry
  # period on all three members). 15 s instead of 2 s cuts them ~7x; a dead
  # leader is replaced within 60 s instead of 15 s.
  controllerManager:
    extraArgs:
      leader-elect-lease-duration: 60s
      leader-elect-renew-deadline: 40s
      leader-elect-retry-period: 15s
  scheduler:
    extraArgs:
      leader-elect-lease-duration: 60s
      leader-elect-renew-deadline: 40s
      leader-elect-retry-period: 15s
  allowSchedulingOnControlPlanes: true
