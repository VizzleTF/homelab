machine:
  certSANs:
%{ for ip in cp_node_ips ~}
    - ${ip}
%{ endfor ~}
cluster:
  etcd:
    # 2381: plain-HTTP metrics for VictoriaMetrics (kubeEtcd), servers VLAN only.
    # No etcd auto-compaction: kube-apiserver compacts every 5 min. Talos does not
    # defrag: `talosctl etcd defrag` by hand, leader last, when dbSize vs dbSizeInUse >40%.
    # heartbeat/election 250 ms/2.5 s: SSD fsync spikes past 1 s cause false
    # elections; must match on all members. batch 1s: cuts bbolt page rewrites
    # (lease renewals); durability stays with the per-request WAL fsync.
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
      quota-backend-bytes: "8589934592"
      heartbeat-interval: "250"
      election-timeout: "2500"
      backend-batch-interval: 1s
---
# tuppr drives upgrades via the Talos API; without this TalosUpgrade CRs fail
# with auth errors.
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - system-upgrade
---
# Workloads run on the control-plane nodes too (3 CP + 1 worker).
apiVersion: v1alpha1
kind: KubeNodeConfig
taints:
  node-role.kubernetes.io/control-plane:
    $patch: delete
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
# Live heap ~1.3 GiB; without a limit GOGC=100 doubles it. Soft limit: Go
# collects more near it, nothing is OOM-killed.
env:
  GOMEMLIMIT: 2GiB
certExtraSANs:
%{ for s in apiserver_cert_sans ~}
  - ${s}
%{ endfor ~}
%{ for ip in cp_node_ips ~}
  - ${ip}
%{ endfor ~}
---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  # baseline: namespaces that need more carry pod-security.kubernetes.io/enforce=privileged
  # (argocd/*/*/manifests/namespace.yaml); apply only after those labels are synced.
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  # No exemptions: Talos already sets [kube-system]; the merge appends a copy and
  # kube-apiserver fails with "exemptions.namespaces[1]: Duplicate value".
---
# Only what Vector forwards to Wazuh (argocd/infra/victoria-logs); logging all
# reads cost 1-4 GB/day per CP disk shared with etcd. exec/attach/portforward
# go first: over websockets they arrive as "get" and the read rule drops them.
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  omitStages:
    - RequestReceived
  rules:
    - level: Metadata
      resources:
        - group: ""
          resources: ["pods/exec", "pods/attach", "pods/portforward"]
    - level: None
      verbs: ["get", "list", "watch"]
    - level: None
      resources:
        - group: coordination.k8s.io
          resources: ["leases"]
        - group: ""
          resources: ["events"]
        - group: events.k8s.io
          resources: ["events"]
        - group: authentication.k8s.io
        - group: authorization.k8s.io
    - level: Metadata
---
# Lease renewals are etcd writes: 15 s retry cuts them ~7x; a dead leader is
# replaced within 60 s.
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  leader-elect-lease-duration: 60s
  leader-elect-renew-deadline: 40s
  leader-elect-retry-period: 15s
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  leader-elect-lease-duration: 60s
  leader-elect-renew-deadline: 40s
  leader-elect-retry-period: 15s
---
# Cilium is the CNI and replaces kube-proxy.
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
