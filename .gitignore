.terraform*
terraform_*/.terraform*
# Not sensitive; Renovate rewrites it with provider bumps.
!terraform_*/.terraform.lock.hcl
terraform_*/_out/
terraform_*/*.tfplan
*.tfstate
*.tfstate.*

*secret*.yaml
*Secret*.yaml
*_secret.yaml
*_Secret.yaml
!*example*.yaml
!*_example.yaml
!charts/**/templates/externalsecret.yaml

*.bak
*.backup

.DS_Store
Thumbs.db

__pycache__/

# Workspace-only artefacts (not part of the homelab repo)
/.claudeignore
/.vscode/
/obsidian
/docs/

# CLAUDE.md and .claude/ reach Forgejo only: ci.yaml step `Strip workspace-only
# paths for GitHub mirror` drops them. Inside .claude/ only whitelisted subtrees
# are tracked; local files and ephemeral dirs stay untracked.
/.claude/*
!/.claude/skills/
!/.claude/reference/
!/.claude/agents/
!/.claude/hooks/
!/.claude/settings.json
# vault_secrets_backup.yaml: covered by *secret*.yaml and .git-hooks/blocklist.sh.
