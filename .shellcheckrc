# Read by every shellcheck run (CI, pre-commit, task ci:lint, by hand).
# Follow sourced files; resolve `# shellcheck source=../lib/x.sh` from the
# script's own dir (default: the cwd). There is no rc key for --severity:
# call sites pass -S warning, agent sessions get it from SHELLCHECK_OPTS in
# .claude/settings.json.
external-sources=true
source-path=SCRIPTDIR
