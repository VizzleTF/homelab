{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homelab-common values",
  "description": "Strict schema for the global.* and homelab-common.* sections. Root level is intentionally permissive so the same values file can hold both an upstream chart's values and this chart's values when used multi-source.",
  "type": "object",
  "properties": { "global": { "$ref": "#/$defs/Global" }, "homelab-common": { "$ref": "#/$defs/HomelabCommon" } },
  "$defs": {
    "Global": {
      "type": "object",
      "description": "Root is permissive because Helm 'global.*' is shared with upstream charts that may add their own keys (e.g. argo-cd global.domain, authentik global.securityContext). Strict validation applies to our known sub-objects only.",
      "properties": {
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretStore": { "type": "string" },
            "secretStoreKind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] },
            "refreshInterval": { "type": "string" },
            "pathPrefix": { "type": "string" }
          }
        },
        "openbao": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "kvMount": { "type": "string" },
            "access": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "grants": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
                "namespaces": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "external": { "$ref": "#/$defs/GatewayRef" },
            "internal": { "$ref": "#/$defs/GatewayRefWithIP" },
            "tls": { "$ref": "#/$defs/GatewayRefWithIP" }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "domain": { "type": "string" } }
        },
        "volsync": {
          "type": "object",
          "description": "VolSync backup defaults and named restic repositories (backup v2).",
          "additionalProperties": false,
          "properties": {
            "snapshotClass": { "type": "string" },
            "storageClass": { "type": "string" },
            "cacheStorageClass": { "type": "string" },
            "cacheCapacity": { "type": "string" },
            "repos": {
              "type": "object",
              "description": "Key is referenced by homelab-common.volsync[].targets[].repo.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["endpoint", "bucket", "keyVaultPath", "passwordVaultPath"],
                "properties": {
                  "endpoint": { "type": "string" },
                  "bucket": { "type": "string" },
                  "prefix": { "type": "string" },
                  "keyVaultPath": { "$ref": "#/$defs/VaultPath" },
                  "passwordVaultPath": { "$ref": "#/$defs/VaultPath" },
                  "retain": { "type": "object", "description": "Default retain for targets of this repo." }
                }
              }
            }
          }
        }
      }
    },
    "VolsyncSpec": {
      "type": "object",
      "description": "One PVC backed up to one or more restic repositories.",
      "additionalProperties": false,
      "required": ["name", "targets"],
      "properties": {
        "name": { "type": "string" },
        "claim": { "type": "string", "description": "sourcePVC; defaults to name." },
        "copyMethod": { "type": "string", "enum": ["Snapshot", "Clone", "Direct"] },
        "accessMode": { "type": "string" },
        "cacheCapacity": { "type": "string" },
        "moverSecurityContext": { "type": "object" },
        "moverResources": { "type": "object" },
        "drill": { "type": "boolean", "description": "In the weekly restore drill (label homelab.dr/drill=<name> on its ReplicationSources); default true. false for volumes larger than the drill's DRILL_SIZE or without both garage and ovh targets." },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "schedule"],
            "properties": {
              "repo": { "type": "string" },
              "schedule": { "type": "string" },
              "retain": { "type": "object" }
            }
          }
        }
      }
    },
    "GatewayRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "namespace": { "type": "string" } }
    },
    "GatewayRefWithIP": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "ip": { "type": "string" }
      }
    },
    "HomelabCommon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSecrets": { "type": "array", "description": "ExternalSecrets read from OpenBao through the release's SecretStore.", "items": { "$ref": "#/$defs/ExternalSecretSpec" } },
        "httpRoutes": { "type": "array", "description": "Gateway API HTTPRoutes on the external, internal or both gateways.", "items": { "$ref": "#/$defs/HTTPRouteSpec" } },
        "tlsRoutes": { "type": "array", "description": "TLSRoutes on the TLS passthrough gateway.", "items": { "$ref": "#/$defs/TLSRouteSpec" } },
        "certificates": { "type": "array", "description": "cert-manager Certificates.", "items": { "$ref": "#/$defs/CertificateSpec" } },
        "rbac": { "type": "array", "description": "ServiceAccount + ClusterRole + ClusterRoleBinding sets.", "items": { "$ref": "#/$defs/RBACSpec" } },
        "limitRange": { "description": "LimitRange default-limits; set in the app that owns the namespace.", "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/LimitRangeSpec" }] },
        "cnpgDatabases": { "type": "array", "description": "CNPG Database CRs.", "items": { "$ref": "#/$defs/CNPGDatabaseSpec" } },
        "workloads": { "type": "array", "description": "Deployments and CronJobs (+ Service) with standard labels, selector and defaults.", "items": { "$ref": "#/$defs/Workload" } },
        "configMaps": { "type": "array", "description": "ConfigMaps named like workloads.", "items": { "$ref": "#/$defs/ConfigMapSpec" } },
        "secrets": { "type": "array", "description": "Plain Secrets named like workloads, for generated non-sensitive objects.", "items": { "$ref": "#/$defs/SecretSpec" } },
        "persistentVolumeClaims": { "type": "array", "description": "PVCs, kept on uninstall (helm.sh/resource-policy: keep).", "items": { "$ref": "#/$defs/PVCSpec" } },
        "volsync": { "type": "array", "description": "VolSync restic backups of a PVC to the global repos.", "items": { "$ref": "#/$defs/VolsyncSpec" } },
        "authentikBlueprints": { "type": "array", "description": "Authentik blueprint ConfigMaps (rendered into ns authentik).", "items": { "$ref": "#/$defs/AuthentikBlueprintSpec" } },
        "networkPolicy": { "$ref": "#/$defs/NetworkPolicySpec", "description": "Default-deny ingress CiliumNetworkPolicy default-ingress plus allow entries." }
      }
    },
    "VaultPath": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "OpenBao path under global.vault.pathPrefix: <namespace>/<purpose>, or a grant from global.openbao.access (checked at render time)."
    },
    "ExternalSecretSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data"],
      "properties": {
        "name": { "type": "string" },
        "vaultPath": { "$ref": "#/$defs/VaultPath" },
        "targetName": { "type": "string" },
        "creationPolicy": { "type": "string", "enum": ["Owner", "Merge", "Orphan", "None"] },
        "deletionPolicy": { "type": "string", "enum": ["Delete", "Merge", "Retain"] },
        "templateType": { "type": "string" },
        "templateEngineVersion": { "type": "string", "enum": ["v2"], "description": "Accepted but not rendered: v2 is the only engine the ExternalSecret v1 CRD allows, and its default." },
        "templateMetadata": { "type": "object" },
        "templateData": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretKey", "property"],
            "properties": {
              "secretKey": { "type": "string" },
              "property": { "type": "string" },
              "vaultPath": { "$ref": "#/$defs/VaultPath" }
            }
          }
        }
      }
    },
    "HTTPRouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hostname"],
      "properties": {
        "name": { "type": "string" },
        "hostname": { "type": "string" },
        "gateway": { "type": "string", "enum": ["external", "internal", "both"] },
        "kedaColdStartLoadingPage": { "type": "boolean" },
        "pathPrefix": { "type": "string" },
        "filters": { "type": "array" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "port"],
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "port": { "type": ["integer", "string"] }
          }
        }
      }
    },
    "TLSRouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hostname", "service"],
      "properties": {
        "name": { "type": "string" },
        "hostname": { "type": "string" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "port"],
          "properties": { "name": { "type": "string" }, "port": { "type": ["integer", "string"] } }
        }
      }
    },
    "CertificateSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "issuerRef", "dnsNames"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "secretName": { "type": "string" },
        "dnsNames": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "kind": { "type": "string", "enum": ["ClusterIssuer", "Issuer"] },
            "name": { "type": "string" }
          }
        }
      }
    },
    "RBACSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "create": { "type": "boolean" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "automountServiceAccountToken": { "type": "boolean" }
          }
        },
        "clusterRole": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string" }, "rules": { "type": "array" } }
        },
        "clusterRoleBinding": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "name": { "type": "string" } }
        }
      }
    },
    "LimitRangeSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "defaults": {
          "type": ["object", "null"],
          "description": "Default limits; null = requests-only (no default: block).",
          "additionalProperties": false,
          "properties": { "cpu": { "type": ["string", "integer"] }, "memory": { "type": "string" } }
        },
        "defaultRequests": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "cpu": { "type": ["string", "integer"] }, "memory": { "type": "string" } }
        }
      }
    },
    "CNPGDatabaseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "clusterName"],
      "properties": {
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "clusterName": { "type": "string" },
        "namespace": { "type": "string" },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string" } }
          }
        }
      }
    },
    "PVCSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accessModes", "storageClassName", "size"],
      "properties": {
        "name": { "type": "string" },
        "size": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "storageClassName": { "type": "string", "minLength": 1 },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "AuthentikBlueprintSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "blueprints"],
      "properties": {
        "name": { "type": "string" },
        "blueprints": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "NetworkPolicySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespaces"],
            "properties": {
              "namespaces": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "ports": { "type": "array", "items": { "type": ["integer", "string"] } }
            }
          }
        }
      }
    },
    "StringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "Workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "containers"],
      "properties": {
        "name": { "type": "string", "description": "Item name; the object is <release>-<name>, or <release> when the release name contains it." },
        "fullnameOverride": { "type": "string", "description": "Exact object name instead of the naming rule." },
        "type": { "type": "string", "enum": ["deployment", "cronjob"], "description": "Controller kind; default deployment." },
        "labels": { "$ref": "#/$defs/StringMap", "description": "Extra labels on the controller and its Service; they win over the standard ones." },
        "annotations": { "$ref": "#/$defs/StringMap", "description": "Extra annotations on the controller." },
        "legacySelector": { "$ref": "#/$defs/StringMap", "minProperties": 1, "description": "Immutable selector of a Deployment created before 1.19; default app.kubernetes.io/{name,instance}." },
        "reload": { "type": "boolean", "description": "Reloader annotations for referenced Secrets/ConfigMaps; default true." },
        "schedule": { "type": "string", "description": "Cron schedule; required for a cronjob, forbidden otherwise." },
        "job": { "type": "object", "description": "Native JobSpec overrides (cronjob); default backoffLimit 2." },
        "spec": { "type": "object", "description": "Native controller spec overrides (DeploymentSpec or CronJobSpec), merged last." },
        "pod": { "type": "object", "not": { "required": ["containers"] }, "description": "Native PodSpec fields except containers; defaults automountServiceAccountToken false, enableServiceLinks false, restartPolicy OnFailure for a cronjob." },
        "containers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Container" }, "description": "Native containers; image is {repository, tag}." },
        "persistence": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Persistence" }, "description": "Volumes by name, mounted into the containers: a persistentVolumeClaims[] claim (RWO -> strategy Recreate) or a native volume source." },
        "service": { "oneOf": [{ "const": false }, { "type": "object" }], "description": "Service from the containers' ports: false disables it, an object overrides ServiceSpec fields (ports replace the generated list)." }
      },
      "if": { "required": ["type"], "properties": { "type": { "const": "cronjob" } } },
      "then": { "required": ["schedule"], "properties": { "service": false, "legacySelector": false, "reload": false } },
      "else": { "properties": { "schedule": false, "job": false } }
    },
    "Container": {
      "type": "object",
      "description": "Native Container fields (kubeconform -strict checks them after render); image is an object.",
      "required": ["name", "image"],
      "properties": {
        "name": { "type": "string", "description": "Container name." },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "description": "Rendered as repository:tag; Renovate's helm-values manager tracks this shape.",
          "properties": { "repository": { "type": "string", "description": "Image repository without tag." }, "tag": { "type": "string", "description": "Exact tag, never latest." } }
        }
      }
    },
    "Persistence": {
      "type": "object",
      "description": "One volume: claim (a persistentVolumeClaims[] name) or one native volume source (emptyDir, configMap, secret, hostPath, ...).",
      "required": ["mountPath"],
      "properties": {
        "claim": { "type": "string", "description": "Name of a persistentVolumeClaims[] item of this release." },
        "mountPath": { "type": "string", "description": "Mount path in the containers." },
        "subPath": { "type": "string", "description": "Optional subPath of the volume." },
        "readOnly": { "type": "boolean", "description": "Mount read-only." },
        "containers": { "type": "array", "items": { "type": "string" }, "description": "Mount only into these containers; default all." },
        "name": false,
        "persistentVolumeClaim": false
      }
    },
    "ConfigMapSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Item name; same naming rule as workloads." },
        "fullnameOverride": { "type": "string", "description": "Exact object name instead of the naming rule." },
        "labels": { "$ref": "#/$defs/StringMap", "description": "Extra labels; they win over the standard ones." },
        "annotations": { "$ref": "#/$defs/StringMap", "description": "Annotations." },
        "data": { "$ref": "#/$defs/StringMap", "description": "Data map." }
      }
    },
    "SecretSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "For generated non-sensitive objects (e.g. ArgoCD repository entries); real secrets come from externalSecrets.",
      "properties": {
        "name": { "type": "string", "description": "Item name; same naming rule as workloads." },
        "fullnameOverride": { "type": "string", "description": "Exact object name instead of the naming rule." },
        "labels": { "$ref": "#/$defs/StringMap", "description": "Extra labels; they win over the standard ones." },
        "annotations": { "$ref": "#/$defs/StringMap", "description": "Annotations." },
        "type": { "type": "string", "description": "Secret type; default Opaque." },
        "data": { "$ref": "#/$defs/StringMap", "description": "Base64-encoded data." },
        "stringData": { "$ref": "#/$defs/StringMap", "description": "Plain-text data." }
      }
    }
  }
}
